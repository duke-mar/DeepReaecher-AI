# ========== 必需配置 ==========

# Firecrawl API 密钥（用于网页搜索）
# 获取方式：访问 https://firecrawl.dev/ 注册账号，在 Dashboard 的 API Keys 页面获取
FIRECRAWL_KEY=

# 大模型 API Key
OPENAI_KEY=

# ========== 大模型配置 ==========

# 大模型 API 地址（OpenAI 兼容接口）
# 如果使用 OpenAI 官方：可留空，默认为 https://api.openai.com/v1
# 如果使用第三方代理或私有部署：填写对应地址
OPENAI_ENDPOINT=

# 自定义模型名称
# 如果使用 OpenAI：可填写 gpt-4o、gpt-4o-mini、o3-mini 等
# 如果使用其他兼容模型：填写对应的模型名称
CUSTOM_MODEL=

# ========== 可选配置 ==========

# Firecrawl 自托管地址（如果自部署 Firecrawl）
# 注意：这是 Firecrawl 服务的基础 URL，不是完整的 API 端点
# 官方 SaaS 服务：留空即可，或填写 https://api.firecrawl.dev/v1
# 自部署服务：填写你的自部署地址，如 http://localhost:3002
FIRECRAWL_BASE_URL=

# ========== 备用搜索引擎配置（可选） ==========
# 当 Firecrawl 搜索失败或返回空结果时，自动降级使用备用搜索引擎
# 支持的搜索引擎格式：Metaso、SerpAPI 等兼容格式

# 备用搜索引擎 1（如 Metaso）
SEARCH_ENGINE_API_URL_1=
SEARCH_ENGINE_API_KEY_1=

# 备用搜索引擎 2（可扩展，如 SerpAPI、Bing 等）
# SEARCH_ENGINE_API_URL_2=
# SEARCH_ENGINE_API_KEY_2=

# Firecrawl 并发限制（默认 2）
FIRECRAWL_CONCURRENCY=

# LLM 上下文窗口大小（默认 128000）
CONTEXT_SIZE=

# API 服务端口（默认 3051）
PORT=
